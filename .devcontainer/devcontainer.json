{
  "name": "beacon",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/jungaretti/features/vim:1": {}
  },
  "remoteUser": "node",
  "containerEnv": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  "onCreateCommand": "corepack enable && corepack prepare pnpm@12.1.0 --activate",
  "updateContentCommand": "sudo chown -R node:node /workspaces/beacon /home/node && pnpm install",
  "postCreateCommand": {
    "git-gpg-format": "git config --global gpg.format ssh"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "bradlc.vscode-tailwindcss",
        "vitest.explorer",
        "ms-vscode.vscode-typescript-next",
        "mhutchie.git-graph",
        "oderwat.indent-rainbow"
      ],
      "settings": {
        "editor.defaultFormatter": "biomejs.biome",
        "editor.formatOnSave": true,
        "js/ts.tsdk.path": "node_modules/typescript/lib"
      }
    }

  },
  "mounts": [
    {
      "source": "beacon_beacon-node_modules",
      "target": "/workspaces/beacon/node_modules",
      "type": "volume"
    }
  ],
  "forwardPorts": [3000, 6006, 4983],
  "portsAttributes": {
    "3000": {
      "label": "Vite Dev Server",
      "onAutoForward": "notify"
    },
    "6006": {
      "label": "Storybook",
      "onAutoForward": "notify"
    },
    "4983": {
      "label": "Drizzle Studio",
      "onAutoForward": "notify"
    }
  }
}
